{
  "name": "tokenization-engine",
  "version": "1.0.0",
  "description": "TypeScript microservice for ERC-3643 token deployment and management",
  "main": "dist/src/app.js",
  "scripts": {
    "build": "tsc && npx hardhat compile",
    "start": "node dist/src/app.js",
    "dev": "ts-node src/app.ts",
    "compile": "npx hardhat compile",
    "test": "npx hardhat test",
    "db:seed": "ts-node src/db/seed.ts",
    "lint": "eslint 'src/**/*.ts'"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ethers": "^6.8.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "sqlite3": "^6.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.0.4",
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@types/cors": "^2.8.15",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.4",
    "@types/node": "^18.18.8",
    "@types/pg": "^8.10.9",
    "@types/sqlite3": "^5.1.0",
    "@types/supertest": "^2.0.16",
    "@typescript-eslint/eslint-plugin": "^6.9.1",
    "@typescript-eslint/parser": "^6.9.1",
    "eslint": "^8.52.0",
    "hardhat": "^2.19.0",
    "supertest": "^6.3.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  }
}
